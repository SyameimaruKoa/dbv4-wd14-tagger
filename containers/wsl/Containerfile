ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-dev build-essential ca-certificates \
    bash coreutils pciutils libimage-exiftool-perl libgomp1 libgl1 \
    libvulkan1 mesa-vulkan-drivers vulkan-tools clinfo intel-opencl-icd \
    ocl-icd-libopencl1 patchelf curl && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/dbv4
COPY *.py requirements.txt run_tagger.sh ./
COPY containers/wsl/entrypoint.sh /usr/local/bin/dbv4-container
RUN sed -i 's/\r$//' run_tagger.sh /usr/local/bin/dbv4-container \
    && chmod +x /usr/local/bin/dbv4-container

WORKDIR /workspace
EXPOSE 5000
ENTRYPOINT ["/usr/local/bin/dbv4-container"]
CMD ["--help"]
